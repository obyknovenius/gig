{
	"name": "Fedora 45",
	"build": {
		"dockerfile": "Containerfile"
	},
	"runArgs": [
		"--hostname=fedora-45",
		"--device=/dev/dri"
	],
	"capAdd": [
		"SYS_ADMIN"
	],
	"securityOpt": [
		"seccomp=unconfined",
		"label=disable",
		"systempaths=unconfined"
	],
	"mounts": [
		"type=tmpfs,target=/tmp,tmpfs-mode=1777",
		"type=bind,source=${localEnv:XDG_RUNTIME_DIR},target=${localEnv:XDG_RUNTIME_DIR}",
		"type=bind,source=${localEnv:HOME}/.claude,target=/home/${localEnv:USER}/.claude"
	],
	"containerEnv": {
		"GSETTINGS_BACKEND": "keyfile",
		"DISPLAY": "${localEnv:DISPLAY}",
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}"
	},
	"features": {
		"ghcr.io/obyknovenius/devcontainer-features/add-user:1": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"mesonbuild.mesonbuild",
				"bodil.blueprint-gtk",
				"Anthropic.claude-code"
			]
		}
	},
	"remoteUser": "${localEnv:USER}"
}
