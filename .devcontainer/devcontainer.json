{
	"name": "Gnome 51",
	"build": {
		"dockerfile": "Containerfile",
		"args": {
			"USERNAME": "${localEnv:USER}"
		}
	},
	"runArgs": [
		"--device=/dev/dri"
	],
	"capAdd": [
		"SYS_ADMIN"
	],
	"securityOpt": [
		"seccomp=unconfined",
		"label=disable",
		"systempaths=unconfined"
	],
	"mounts": [
		"type=bind,source=${localEnv:XDG_RUNTIME_DIR},target=${localEnv:XDG_RUNTIME_DIR}",
		"type=bind,source=/usr/share/fonts,target=/usr/share/fonts,readonly",
		"type=bind,source=/usr/share/icons,target=/usr/share/icons,readonly",
		"type=tmpfs,target=/tmp,tmpfs-mode=1777"
	],
	"containerEnv": {
		"GSETTINGS_BACKEND": "keyfile",
		"XDG_RUNTIME_DIR": "${localEnv:XDG_RUNTIME_DIR}",
		"DISPLAY": "${localEnv:DISPLAY}",
		"WAYLAND_DISPLAY": "${localEnv:WAYLAND_DISPLAY}"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-vscode.cpptools",
				"mesonbuild.mesonbuild",
				"bodil.blueprint-gtk",
				"Anthropic.claude-code",
				"github.vscode-github-actions"
			]
		}
	},
	"remoteUser": "${localEnv:USER}"
}
