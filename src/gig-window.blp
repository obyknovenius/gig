using Gtk 4.0;
using Adw 1;

template $GigWindow: Adw.ApplicationWindow {
    notify::fullscreened => $gig_window_notify_fullscreened_cb();

    Adw.TabOverview {
        view: tab_view;
        enable-new-tab: true;
        create-tab => $gig_window_tab_overview_create_tab_cb() swapped;

        child: Adw.ToolbarView {
            top-bar-style: raised_border;
            reveal-top-bars: bind template.fullscreened inverted;

            [top]
            Adw.HeaderBar {
                [start]
                Gtk.Box {
                    spacing: 6;

                    Gtk.Button {
                        icon-name: "go-previous-symbolic";
                        action-name: "win.go-back";
                    }

                    Gtk.Button {
                        icon-name: "go-next-symbolic";
                        action-name: "win.go-forward";
                    }

                    Gtk.Button stop_reload_button {
                        icon-name: "view-refresh-symbolic";
                        action-name: "win.stop-reload";
                    }
                }

                [title]
                Adw.Clamp clamp {
                    hexpand: true;
                    maximum-size: 860;

                    $GigAddressBar address_bar {}
                }

                [end]
                Gtk.Box {
                    spacing: 6;

                    Gtk.Button {
                        icon-name: "tab-new-symbolic";
                        action-name: "win.new-tab";
                    }

                    Gtk.Button {
                        icon-name: "view-grid-symbolic";
                        action-name: "overview.open";
                    }

                    Gtk.MenuButton {
                        icon-name: "open-menu-symbolic";
                        menu-model: primary_menu;
                    }
                }
            }

            [top]
            Adw.TabBar {
                view: tab_view;
            }

            Adw.TabView tab_view {
                menu-model: tab_menu;
                close-page => $gig_window_tab_view_close_page_cb() swapped;
                setup-menu => $gig_window_tab_view_setup_menu_cb() swapped;
                create-window => $gig_window_tab_view_create_window_cb() swapped;
                page-detached => $gig_window_tab_view_page_detached_cb() swapped;
                notify::selected-page => $gig_window_notify_tab_view_selected_page_cb() swapped;
            }
        };
    }
}

menu primary_menu {
    section {
        item {
            label: "New Tab";
            action: "win.new-tab";
        }

        item {
            label: "New Window";
            action: "win.new-window";
        }
    }

    section {
        item {
            label: "Find";
            action: "tab.find";
        }
    }

    section {
        item {
            label: "Fullscreen";
            action: "win.fullscreen";
            hidden-when: "action-disabled";
        }

        item {
            label: "Leave Fullscreen";
            action: "win.unfullscreen";
            hidden-when: "action-disabled";
        }
    }

    section {
        item {
            label: "About Side Gig";
            action: "app.about";
        }
    }
}

menu tab_menu {
    section {
        item {
            label: "Pin";
            action: "tab.pin";
            hidden-when: "action-disabled";
        }

        item {
            label: "Unpin";
            action: "tab.unpin";
            hidden-when: "action-disabled";
        }

        item {
            label: "Duplicate";
            action: "tab.duplicate";
        }
    }

    section {
        item {
            label: "Close to the Left";
            action: "tab.close-before";
        }

        item {
            label: "Close to the Right";
            action: "tab.close-after";
        }

        item {
            label: "Close Others";
            action: "tab.close-others";
        }

        item {
            label: "Close";
            action: "tab.close";
        }
    }
}
