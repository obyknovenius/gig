using Gtk 4.0;
using Adw 1;

template $GigTab: Gtk.Widget {
    Adw.ToolbarView toolbar_view {
        bottom-bar-style: raised_border;
        reveal-bottom-bars: false;

        content: Gtk.Stack stack {
            Gtk.StackPage {
                child: Adw.StatusPage new_tab_page {
                    title: "New Tab";
                    description: "Search the web or enter a website address";
                };
            }
        };
    }
}
