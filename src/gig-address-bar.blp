using Gtk 4.0;

template $GigAddressBar: Gtk.Widget {
    Gtk.Entry entry {
        placeholder-text: "Search or enter website address";
        primary-icon-name: "system-search-symbolic";
        primary-icon-sensitive: false;
        sensitive: false;
        changed => $gig_address_bar_entry_changed_cb() swapped;
        activate => $gig_address_bar_entry_activate_cb() swapped;
        icon-release => $gig_address_bar_entry_icon_release_cb() swapped;

        Gtk.EventControllerLegacy {
            propagation-phase: capture;
            event => $gig_address_bar_entry_event_cb() swapped;
        }

        Gtk.EventControllerFocus {
            enter => $gig_address_bar_entry_focus_enter_cb() swapped;
            leave => $gig_address_bar_entry_focus_leave_cb() swapped;
        }
    }
}
